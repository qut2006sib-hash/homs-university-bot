# Copy this file to .env and fill in the real values on the machine that runs the bot.
# Never commit .env, the bot token, the admin key, or the SQLite file.

# Token from BotFather. Leave empty to develop the engine and the admin CLI without Telegram.
TELEGRAM_BOT_TOKEN=

# SQLite file. Created automatically. Do not commit it.
HU_DB_PATH=data/homs_bot.sqlite

# Synthetic demonstration rows are stored with is_synthetic=1.
# They are invisible unless this flag is 1, and even then they are labelled
# as non-authoritative. Real approved answers do not need this flag.
HU_ALLOW_SYNTHETIC=0

# Local administrator CLI. Store only the hash here, never the key itself.
# Generate it with: python -m homs_bot.admin_cli admin-key-hash
# Then export HU_ADMIN_KEY in the shell for each admin session.
HU_ADMIN_KEY_SHA256=
# Telegram /admin replies only for ids listed below.
HU_ADMIN_IDS=

# Lab CLI database. Must differ from HU_DB_PATH; the lab seeds synthetic rows into it.
HU_LAB_DB_PATH=data/lab.sqlite

# Lexical similarity scores are not probabilities.
HU_MATCH_AUTO=0.84
HU_MATCH_CLARIFY=0.62
HU_MATCH_MARGIN=0.06

# Per Telegram user.
HU_RATE_LIMIT_COUNT=8
HU_RATE_LIMIT_WINDOW=30

HU_LOG_LEVEL=INFO
